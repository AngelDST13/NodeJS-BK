{
  "name": "securevault",
  "version": "1.0.0",
  "private": true,
  "description": "SecureVault: notas privadas cifradas con Node.js aplicando OWASP Top 10:2025",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --env-file=.env --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "migrate:dev": "node --env-file=.env src/db/migrate.js",
    "create-admin": "node --env-file-if-exists=.env scripts/create-admin.js",
    "rotate-keys": "node --env-file-if-exists=.env scripts/rotate-keys.js",
    "gen-keys": "node scripts/gen-keys.js",
    "db:up": "docker compose up -d db",
    "test": "node --env-file-if-exists=.env.test --test --test-concurrency=1 \"test/**/*.test.js\""
  },
  "license": "UNLICENSED",
  "dependencies": {
    "argon2": "^0.45.2",
    "connect-pg-simple": "^10.0.0",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.2"
  }
}

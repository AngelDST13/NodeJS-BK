# Copia este archivo a .env (excluido de Git) y genera los secretos con: npm run gen-keys
# En producción, estas variables se configuran en el panel de secretos de la plataforma.

NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
TRUST_PROXY=0
LOG_LEVEL=info

DATABASE_URL=postgres://securevault:securevault@localhost:5432/securevault
DATABASE_SSL=false

SESSION_SECRET=
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_KEY_VERSION=1
# Llaves anteriores durante una rotación: "1:<base64>,2:<base64>"
DATA_ENCRYPTION_OLD_KEYS=
AUDIT_HMAC_KEY=

# Opcional: correo de recuperación (sin SMTP, en desarrollo el enlace sale en la consola)
SMTP_URL=
MAIL_FROM=SecureVault <no-reply@example.com>

# Opcional: alertas a Slack/Discord (el host debe estar en ALERT_ALLOWED_HOSTS)
ALERT_WEBHOOK_URL=
ALERT_ALLOWED_HOSTS=hooks.slack.com,discord.com
LOGIN_ALERT_THRESHOLD=5

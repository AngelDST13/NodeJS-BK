<%- include('partials/auth-top') %>
<h1>Entra a tu libreta</h1>
<%- include('partials/messages') %>
<form method="post" action="/login" class="stack" novalidate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="field">
    <label for="email">Correo</label>
    <input id="email" type="email" name="email" value="<%= values.email || '' %>" autocomplete="username" required maxlength="254">
  </div>
  <div class="field">
    <div class="field-head">
      <label for="password">Contraseña</label>
      <a href="/forgot-password" class="aside-link">La olvidé</a>
    </div>
    <input id="password" type="password" name="password" autocomplete="current-password" required maxlength="128">
  </div>
  <button type="submit" class="btn btn-primary btn-block">Entrar</button>
</form>
<p class="switch">¿Primera vez aquí? <a href="/register">Crea una cuenta</a></p>
<%- include('partials/auth-bottom') %>

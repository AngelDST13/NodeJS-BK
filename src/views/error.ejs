<%- include('partials/header') %>
<section class="notice-page">
  <%- include('partials/seal', { sealClass: 'seal-md seal-muted' }) %>
  <h1><%= title %></h1>
  <p><%= message %></p>
  <% if (typeof errorId !== 'undefined' && errorId) { %>
    <p class="hint">Código de referencia: <code><%= errorId %></code></p>
  <% } %>
  <p><a href="/" class="btn btn-secondary">Ir al inicio</a></p>
</section>
<%- include('partials/footer') %>

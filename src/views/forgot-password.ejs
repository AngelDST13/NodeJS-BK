<%- include('partials/auth-top') %>
<h1>Recupera el acceso</h1>
<p class="lede">Escribe tu correo y te enviaremos un enlace para elegir una contraseña nueva. Vale 30 minutos y se usa una sola vez.</p>
<%- include('partials/messages') %>
<% if (info) { %><p class="msg msg-ok" role="status"><%= info %></p><% } %>
<form method="post" action="/forgot-password" class="stack" novalidate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="field">
    <label for="email">Correo</label>
    <input id="email" type="email" name="email" autocomplete="email" required maxlength="254">
  </div>
  <button type="submit" class="btn btn-primary btn-block">Enviar enlace</button>
</form>
<p class="switch"><a href="/login">Volver a entrar</a></p>
<%- include('partials/auth-bottom') %>

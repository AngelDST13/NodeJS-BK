<%- include('partials/auth-top') %>
<h1>Elige una contraseña nueva</h1>
<%- include('partials/messages') %>
<% if (token) { %>
  <p class="lede">Al guardarla se cerrarán todas tus sesiones abiertas.</p>
  <form method="post" action="/reset-password" class="stack" data-auth-form novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="token" value="<%= token %>">
    <div class="field">
      <label for="password">Contraseña nueva</label>
      <input id="password" type="password" name="password" data-strength autocomplete="new-password" required minlength="12" maxlength="128" aria-describedby="pw-help">
      <p id="pw-help" class="hint">12 caracteres o más, con mayúscula, minúscula, número y símbolo.</p>
    </div>
    <div class="field">
      <label for="confirmPassword">Repite la contraseña</label>
      <input id="confirmPassword" type="password" name="confirmPassword" data-match="password" autocomplete="new-password" required maxlength="128">
    </div>
    <button type="submit" class="btn btn-primary btn-block">Guardar contraseña</button>
  </form>
<% } else { %>
  <p><a href="/forgot-password" class="btn btn-primary">Pedir un enlace nuevo</a></p>
<% } %>
<%- include('partials/auth-bottom') %>

<%- include('partials/header') %>
<article class="narrow">
  <h1>Nueva contraseña</h1>
  <%- include('partials/messages') %>
  <% if (token) { %>
    <form method="post" action="/reset-password" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="token" value="<%= token %>">
      <label>Nueva contraseña
        <input type="password" name="password" autocomplete="new-password" required minlength="12" maxlength="128">
        <small>Mínimo 12 caracteres, con mayúscula, minúscula, número y símbolo.</small>
      </label>
      <label>Confirmar contraseña
        <input type="password" name="confirmPassword" autocomplete="new-password" required maxlength="128">
      </label>
      <button type="submit">Guardar contraseña</button>
    </form>
  <% } else { %>
    <p><a href="/forgot-password">Solicitar un enlace nuevo</a></p>
  <% } %>
</article>
<%- include('partials/footer') %>

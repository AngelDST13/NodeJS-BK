<% if (typeof flash !== 'undefined' && flash) { %>
  <p class="msg msg-ok" role="status"><%= flash %></p>
<% } %>
<% if (typeof errors !== 'undefined' && errors.length) { %>
  <div class="msg msg-error" role="alert">
    <% if (errors.length === 1) { %>
      <p><%= errors[0] %></p>
    <% } else { %>
      <ul><% errors.forEach((e) => { %><li><%= e %></li><% }) %></ul>
    <% } %>
  </div>
<% } %>

<%- include('head') %>
<body class="app">
  <a class="skip" href="#contenido">Saltar al contenido</a>
  <header class="topbar">
    <a href="/" class="brand">
      <%- include('seal', { sealClass: 'seal-sm' }) %>
      <span class="wordmark">Sigilo</span>
    </a>
    <% if (currentUser) { %>
      <nav class="mainnav" aria-label="Principal">
        <a href="/notes">Notas</a>
        <a href="/profile">Perfil</a>
        <% if (currentUser.role === 'admin') { %><a href="/admin">Administración</a><% } %>
      </nav>
      <div class="session">
        <span class="who"><%= currentUser.name %></span>
        <form method="post" action="/logout">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-quiet">Salir</button>
        </form>
      </div>
    <% } else { %>
      <nav class="mainnav" aria-label="Principal">
        <a href="/login">Entrar</a>
        <a href="/register">Crear cuenta</a>
      </nav>
    <% } %>
  </header>
  <main id="contenido" class="page">

<%- include('partials/header') %>
<div class="page-head"><h1>Administración</h1></div>
<%- include('partials/messages') %>

<section class="block">
  <h2>Usuarios <span class="count"><%= users.length %></span></h2>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Correo</th><th>Nombre</th><th>Rol</th><th>Estado</th><th>Alta</th><th><span class="visually-hidden">Acciones</span></th></tr></thead>
      <tbody>
        <% users.forEach((u) => { %>
          <tr>
            <td><%= u.email %></td>
            <td><%= u.name %></td>
            <td><span class="tag <%= u.role === 'admin' ? 'tag-admin' : '' %>"><%= u.role === 'admin' ? 'Administrador' : 'Usuario' %></span></td>
            <td>
              <% if (u.locked) { %><span class="tag tag-warn">Bloqueado</span>
              <% } else if (u.failed_login_count > 0) { %><%= u.failed_login_count %> intentos fallidos
              <% } else { %>Activo<% } %>
            </td>
            <td><%= formatDate(u.created_at, { dateStyle: 'medium' }) %></td>
            <td class="cell-action">
              <% if (u.locked || u.failed_login_count > 0) { %>
                <form method="post" action="/admin/users/<%= u.id %>/unlock">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn btn-quiet btn-sm">Desbloquear</button>
                </form>
              <% } %>
              <% if (u.id !== currentUser.id) { %>
                <form method="post" action="/admin/users/<%= u.id %>/role">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="role" value="<%= u.role === 'admin' ? 'user' : 'admin' %>">
                  <button type="submit" class="btn btn-quiet btn-sm"><%= u.role === 'admin' ? 'Quitar administrador' : 'Hacer administrador' %></button>
                </form>
              <% } else { %><span class="hint">Tú</span><% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>

<section class="block">
  <h2>Bitácora de seguridad</h2>
  <p class="hint">Últimos 100 eventos. Cada registro lleva una firma HMAC; si alguien lo modifica directamente en la base de datos, aparece como alterado.</p>
  <div class="table-wrap">
    <table class="log">
      <thead><tr><th>Fecha</th><th>Evento</th><th>Actor</th><th>Objetivo</th><th>IP</th><th>Detalle</th><th>Firma</th></tr></thead>
      <tbody>
        <% events.forEach((e) => { %>
          <tr class="<%= e.intact ? '' : 'tampered' %>">
            <td class="nowrap"><%= formatDate(e.occurred_at) %></td>
            <td><code><%= e.event_type %></code></td>
            <td><%= e.actor_email || '—' %></td>
            <td class="small"><%= e.target_id || '—' %></td>
            <td><%= e.ip || '—' %></td>
            <td class="small"><%= JSON.stringify(e.details) %></td>
            <td><% if (e.intact) { %><span class="tag tag-ok">OK</span><% } else { %><span class="tag tag-bad">ALTERADO</span><% } %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>
<%- include('partials/footer') %>
